<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>Sander</AssemblyName>
  </PropertyGroup>

  <!-- Cross-platform configuration (default) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DefineConstants>$(DefineConstants);CROSSPLATFORM</DefineConstants>
  </PropertyGroup>

  <!-- Linux fallback configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Linux'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <AssemblyName>Sander_Linux_fallback</AssemblyName>
    <DefineConstants>$(DefineConstants);LINUX_FALLBACK;CROSSPLATFORM</DefineConstants>
  </PropertyGroup>

  <!-- Windows fallback configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Windows'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <AssemblyName>Sander_Windows_fallback</AssemblyName>
    <DefineConstants>$(DefineConstants);WINDOWS_FALLBACK;CROSSPLATFORM</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.6" />
    <PackageReference Include="Hexa.NET.ImGui" Version="2.2.10-prerelease" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>Resources/0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Content.Client">
      <HintPath>Resources/Content.Client.dll</HintPath>
    </Reference>
    <Reference Include="Content.Shared">
      <HintPath>Resources/Content.Shared.dll</HintPath>
    </Reference>
    <Reference Include="Robust.Client">
      <HintPath>Resources/Robust.Client.dll</HintPath>
    </Reference>
    <Reference Include="Robust.Shared">
      <HintPath>Resources/Robust.Shared.dll</HintPath>
    </Reference>
    <Reference Include="Robust.Shared.Maths">
      <HintPath>Resources/Robust.Shared.Maths.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
